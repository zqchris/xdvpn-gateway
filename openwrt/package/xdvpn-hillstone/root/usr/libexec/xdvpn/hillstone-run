#!/bin/sh
# Own retry timing: netifd otherwise retries failed child processes immediately.
. /lib/netifd/netifd-proto.sh
child=''
stopping=0
stop() {
    stopping=1
    [ -z "$child" ] || kill -TERM "$child" 2>/dev/null
    [ -z "$child" ] || wait "$child" 2>/dev/null
    exit 0
}
trap stop TERM INT
backoff=5
while :; do
    started=$(awk '{print int($1)}' /proc/uptime)
    /usr/sbin/xdvpn-hillstone -netifd &
    child=$!
    wait "$child"
    result=$?
    child=''
    [ "$stopping" = 0 ] || exit 0
    [ "$result" != 0 ] || exit 0
    if [ "$result" = 2 ]; then
        proto_notify_error xdvpn AUTH_OR_CONFIG_ERROR
        proto_block_restart xdvpn
        exit 1
    fi
    ended=$(awk '{print int($1)}' /proc/uptime)
    [ "$((ended-started))" -lt 120 ] || backoff=5
    logger -t xdvpn "Hillstone connection ended; retry in ${backoff}s"
    sleep "$backoff" &
    child=$!
    wait "$child"
    child=''
    backoff=$((backoff*2))
    [ "$backoff" -le 300 ] || backoff=300
done
