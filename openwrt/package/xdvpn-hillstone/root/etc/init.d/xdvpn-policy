#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
start_service() {
 [ -s /var/run/xdvpn-openconnect.json ] || return 1
 procd_open_instance
 procd_set_param command /usr/sbin/xdvpn-hillstone -policy-watch
 procd_set_param env GOMEMLIMIT=24MiB
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
